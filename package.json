{
  "name": "christmas-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @christmas-games/play dev",
    "build": "pnpm --filter @christmas-games/play build && pnpm --filter @christmas-games/catalog-server build",
    "build:staging-demo": "pnpm --filter @christmas-games/play build:staging-demo && pnpm --filter @christmas-games/catalog-server build",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "architecture": "depcruise --config .dependency-cruiser.cjs apps packages tools --output-type err-long",
    "deadcode": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "repo:map": "node tools/repo-map.mjs --write",
    "repo:map:check": "node tools/repo-map.mjs --check",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm test:unit",
    "check": "pnpm check:fast && pnpm architecture && pnpm deadcode && pnpm format:check && pnpm repo:map:check",
    "test:e2e": "playwright test",
    "validate": "pnpm check && pnpm asset:validate:all && pnpm build && pnpm test:e2e",
    "fixtures:generate": "pnpm --filter @christmas-games/fixture-generator generate",
    "media:process": "pnpm --filter @christmas-games/media-pipeline process",
    "media:inspect": "pnpm --filter @christmas-games/media-pipeline inspect",
    "media:prepare-local": "pnpm --filter @christmas-games/media-pipeline prepare-local",
    "gallery:prepare": "pnpm --filter @christmas-games/media-pipeline gallery-lab --prepare-only",
    "gallery:lab": "pnpm --filter @christmas-games/media-pipeline gallery-lab",
    "deploy:readiness": "node tools/deploy/prepare-vps-release.mjs --stage staging-demo --check-only",
    "release:staging": "pnpm deploy:readiness && pnpm build:staging-demo && node tools/deploy/prepare-vps-release.mjs --stage staging-demo",
    "game:new": "pnpm --filter @christmas-games/game-generator new",
    "asset:doctor": "pnpm --filter @christmas-games/asset-factory run doctor",
    "asset:validate": "pnpm --filter @christmas-games/asset-factory run validate",
    "asset:audit": "pnpm --filter @christmas-games/asset-factory run audit",
    "asset:catalog": "pnpm --filter @christmas-games/asset-factory run catalog",
    "asset:budget": "pnpm --filter @christmas-games/asset-factory run budget",
    "asset:manifest": "pnpm --filter @christmas-games/asset-factory run manifest",
    "asset:migrate": "pnpm --filter @christmas-games/asset-factory run migrate",
    "puzzle:source-reader": "node tools/export-puzzle-source-reader.mjs",
    "clean:reports": "node tools/clean.mjs",
    "agent:doctor": "node tools/agent-doctor.mjs",
    "test:e2e:gallery": "playwright test tests/e2e/session-gallery.spec.ts",
    "release:verify": "node tools/deploy/verify-vps-release.mjs",
    "deploy:smoke": "node tools/deploy/smoke-staging.mjs",
    "validate:staging": "pnpm agent:doctor && pnpm check && pnpm asset:validate:all && pnpm test:e2e:gallery && pnpm release:staging && pnpm release:verify && pnpm release:smoke-runtime",
    "deploy:staging-config": "node tools/deploy/create-staging-preview-config.mjs",
    "asset:validate:all": "pnpm --filter @christmas-games/asset-factory run validate-all",
    "release:smoke-runtime": "node tools/deploy/smoke-release-runtime.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.4",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.0",
    "eslint-plugin-boundaries": "7.2.0",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
