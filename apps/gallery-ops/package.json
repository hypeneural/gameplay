{
  "name": "@christmas-games/gallery-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit --project ../../tsconfig.json && vite build",
