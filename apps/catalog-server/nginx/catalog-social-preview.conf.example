# Inclua este bloco no servidor HTTPS que já entrega o build de apps/play.
# O Node fica inacessível diretamente pela internet; somente o Nginx o chama.

location ~ ^/s/[A-Za-z0-9_-]{16,128}(?:/game/[a-z0-9-]{1,64})?(?:/social-preview)?$ {
    proxy_pass http://127.0.0.1:4180;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

# A arte genérica não contém foto de cliente. Mesmo assim é acessível somente
# depois de o endpoint autorizar o token e devolver X-Accel-Redirect.
location = /_catalog_social/evydencia-christmas-v1.webp {
    internal;
    alias /srv/christmas-games/catalog-social/evydencia-christmas-v1.webp;
    default_type image/webp;
}

# Esta pasta recebe exclusivamente derivados sociais aprovados, sem original,
# nome, telefone ou metadado de cliente. O backend só emite esta URI enquanto
# consentimento e vínculo da sessão continuarem válidos.
location ~ ^/_customer_social/([A-Za-z0-9_-]{16,128})\.webp$ {
    internal;
    alias /srv/christmas-private/derived/social/$1.webp;
    default_type image/webp;
}
