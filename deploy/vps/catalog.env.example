# Copy to /etc/christmas-games/catalog.env and chmod 600.
# This repository currently permits VPS staging-demo only. Do not put real
# customer tokens or credentials in this file or commit its production copy.
NODE_ENV=production
CATALOG_RELEASE_STAGE=staging-demo
CATALOG_PUBLIC_ORIGIN=https://jogos.example.com
CATALOG_SOCIAL_PREVIEW_FILE=/etc/christmas-games/social-preview.json
CATALOG_APPLICATION_SHELL=/srv/christmas-games/current/web/index.html
PORT=4180

# Private publication remains closed to new CRM orders until BOTH settings are present.
# The CRM must expose GET /internal/v1/orders/{uuid}/eligibility with an authenticated
# response containing the SAME orderUuid, status and isEligibleForGallery.
# CATALOG_CRM_ELIGIBILITY_ORIGIN=https://crm-private.example.com
# CATALOG_CRM_API_SECRET_FILE=/srv/secrets/christmas-games/crm-eligibility.secret
#
# Keep file-demo on the current staging to preserve existing synthetic links.
# After validating SQLite migrations and migrated synthetic fixtures, opt in:
# CATALOG_PREVIEW_AUTHORITY=sqlite
# CATALOG_DATABASE_PATH=/var/lib/christmas-games/sqlite/catalog.db
# CATALOG_STORAGE_DIR=/var/lib/christmas-games/media
# PUBLISHER_API_SECRET_FILE=/srv/secrets/christmas-games/publisher.secret
# CATALOG_SERVER_SECRET_FILE=/srv/secrets/christmas-games/server.secret
