# Include inside the HTTPS server block for the games hostname.
# TLS/certificates remain owned by the VPS/Plesk configuration.

root /srv/christmas-games/current/web;

# Vite content-hashed assets are public application code, never customer media.
location ^~ /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
}

# staging-demo uses only synthetic fixture photos copied by Vite from public/.
# Keep this location explicit so it cannot become a generic SPA fallback.
location ^~ /fixtures/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=3600" always;
    add_header X-Content-Type-Options "nosniff" always;
}

location = /favicon.svg {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=86400" always;
    add_header X-Content-Type-Options "nosniff" always;
}

# Token-free liveness endpoint for systemd/monitoring.
location = /healthz {
    access_log off;
    proxy_pass http://127.0.0.1:4180;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Session URLs contain capability tokens. Do not emit them into Nginx access
# logs. This covers Hub, direct Gallery reload, games and social preview.
location ~ ^/s/[A-Za-z0-9_-]{16,128}(?:/fotos|/game/[a-z0-9-]{1,64}|/social-preview)?$ {
    access_log off;
    log_not_found off;
    proxy_pass http://127.0.0.1:4180;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
}

# Generic social image. It is reachable only after backend authorization via
# X-Accel-Redirect.
location = /_catalog_social/evydencia-christmas-v2.jpg {
    internal;
    alias /srv/christmas-games/current/public/social/evydencia-christmas-v2.jpg;
    default_type image/jpeg;
    add_header X-Content-Type-Options "nosniff" always;
}

location = /_catalog_social/evydencia-christmas-v2.webp {
    internal;
    alias /srv/christmas-games/current/public/social/evydencia-christmas-v2.webp;
    default_type image/webp;
    add_header X-Content-Type-Options "nosniff" always;
}

location = /_catalog_social/evydencia-christmas-v1.webp {
    internal;
    alias /srv/christmas-games/current/public/social/evydencia-christmas-v1.webp;
    default_type image/webp;
    add_header X-Content-Type-Options "nosniff" always;
}

# Reserved for approved customer social derivatives in the future pilot. The
# current staging-demo readiness contract does not permit customer data.
location ~ "^/_customer_social/([A-Za-z0-9_-]{16,128})\.(webp|jpg)$" {
    internal;
    alias /srv/christmas-private/derived/social/$1.$2;
    add_header X-Content-Type-Options "nosniff" always;
}

# Only studio-owned generic social art is public; customer art stays internal.
location = /social/evydencia-christmas-v2.jpg {
    alias /srv/christmas-games/current/public/social/evydencia-christmas-v2.jpg;
    default_type image/jpeg;
    add_header Cache-Control "public, max-age=86400" always;
    add_header X-Content-Type-Options "nosniff" always;
}

location = /social/evydencia-christmas-v2.webp {
    alias /srv/christmas-games/current/public/social/evydencia-christmas-v2.webp;
    default_type image/webp;
    add_header Cache-Control "public, max-age=86400" always;
    add_header X-Content-Type-Options "nosniff" always;
}

location = /social/evydencia-christmas-v1.webp {
    alias /srv/christmas-games/current/public/social/evydencia-christmas-v1.webp;
    default_type image/webp;
    add_header Cache-Control "public, max-age=86400" always;
    add_header X-Content-Type-Options "nosniff" always;
}

# Public synthetic demo only. Keep all unknown paths at 404.
location = / {
    proxy_pass http://127.0.0.1:4180;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
}

location = /demo { return 302 /; }
location = /demo/ { return 302 /; }

location = /demo/fotos {
    proxy_pass http://127.0.0.1:4180;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control "no-store" always;
}

location ~ "^/demo/game/[a-z0-9-]{1,64}$" {
    proxy_pass http://127.0.0.1:4180;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control "no-store" always;
}

# Do not accidentally expose the SPA shell at arbitrary paths.
location / {
    return 404;
}
